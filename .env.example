FRONTEND_URL=https://funpace.media
ALLOWED_ORIGINS=https://funpace.media,https://www.funpace.media,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=https://funpace.media,https://www.funpace.media,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_MAX=450
API_MAX_BODY_BYTES=262144
API_JSON_BODY_LIMIT_BYTES=204800
WEBHOOK_MAX_BODY_BYTES=204800
ADMIN_IP_ALLOWLIST=
OPERATIONS_SECRET=
CRON_SECRET=

# Rate limit distribuido opcional. Sem estes valores, o fallback local em memoria continua ativo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Banco para migrations seguras.
# Arquitetura multi-fotografo/face global esta adiada para a Fase 2.
# Nao aplique scripts/add-multiphoto-face-architecture.sql durante a estabilizacao operacional.
# Quando a Fase 2 for retomada, use staging antes de producao.
STAGING_DATABASE_URL=
PRODUCTION_DATABASE_URL=
ENABLE_DEFERRED_MULTIPHOTO_FACE_ARCHITECTURE=false

# AWS Rekognition facial search.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_BUCKET_NAME=funpace-media
AWS_REKOGNITION_COLLECTION=funpace-faces
AWS_REQUEST_TIMEOUT_MS=20000
FACE_SIMILARITY_THRESHOLD=90
FACE_SEARCH_MAX_CANDIDATES=1000
FACE_SEARCH_MAX_UPLOAD_BYTES=8388608
FACE_BACKFILL_CONCURRENCY=3
FACE_BACKFILL_MAX_IMAGE_BYTES=31457280
FACE_BACKFILL_DOWNLOAD_TIMEOUT_MS=30000

MEDIA_STORAGE_PROVIDER=external_bucket
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_UPLOAD_MAX_BYTES=314572800
DOWNLOAD_ACCESS_DAYS=30
DOWNLOAD_LINK_TTL_SECONDS=300
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_SOURCE_TIMEOUT_MS=30000
PLATFORM_FEE_PERCENT=30
PHOTOGRAPHER_EARNINGS_RELEASE_DAYS=7

PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=
INFINITEPAY_CHECKOUT_ENDPOINT=https://api.checkout.infinitepay.io/links
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_PAYMENT_CHECK_ENDPOINT=https://api.checkout.infinitepay.io/payment_check
INFINITEPAY_CHECKOUT_ALLOWED_HOSTS=infinitepay.io,checkout.infinitepay.io,api.checkout.infinitepay.io
INFINITEPAY_WEBHOOK_URL=https://funpace.media/api/webhooks/infinitepay
# A documentacao da InfinitePay nao informa assinatura/token no webhook.
# Deixe false para validar o webhook por payment_check com order_nsu, transaction_nsu e invoice_slug.
INFINITEPAY_WEBHOOK_REQUIRE_AUTH=false
INFINITEPAY_WEBHOOK_SECRET=

# E-mail transacional apos pagamento aprovado.
RESEND_API_KEY=
EMAIL_FROM=Funpace Media <no-reply@funpace.media>
SUPPORT_EMAIL=funpacerunclub@gmail.com
CONTACT_EMAIL=funpacerunclub@gmail.com
NOTIFICATION_EMAIL=funpacerunclub@gmail.com

# Estrutura futura. Nao usada enquanto PAYMENT_PROVIDER=infinitepay.
PAGARME_API_KEY=
