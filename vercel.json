{
  "functions": {
    "api/checkout/create-session.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/payments/reconcile?limit=50&minAgeMinutes=5",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
